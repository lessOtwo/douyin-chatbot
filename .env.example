# 首次使用 start.ps1 / start.sh 自动复制并生成下列密钥，不覆盖已有 .env。
BUSINESS_API_KEY=GENERATE
INTERNAL_API_KEY=GENERATE
DATABASE_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
ENCRYPTION_SECRET=GENERATE
FASTGPT_ROOT_PASSWORD=GENERATE
FASTGPT_SYSTEM_KEY=GENERATE
FASTGPT_PLUGIN_TOKEN=GENERATE
FASTGPT_SANDBOX_TOKEN=GENERATE
AIPROXY_TOKEN=GENERATE
MINIO_ACCESS_KEY=chatbotadmin
MINIO_SECRET_KEY=GENERATE

FASTGPT_VERSION=v4.17.2
FASTGPT_PLUGIN_VERSION=v1.1.4
FASTGPT_SANDBOX_VERSION=v4.17.0
MINIO_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/minio:RELEASE.2025-09-07T16-13-09Z
BIND_ADDRESS=127.0.0.1
BUSINESS_PORT=8088
FASTGPT_PORT=3000
BUSINESS_URL=http://localhost:8088
FASTGPT_PUBLIC_URL=http://localhost:3000

SECURE_COOKIE=false

# 首次登录 FastGPT 创建并发布工作流后配置应用密钥；审核通过的商家账号由后台自动生成，工作流应用仍需绑定。
FASTGPT_APP_KEY=
ADMIN_TOOLS_AUTO_LOGIN=true
SEND_MODE=mock
PLATFORM_SEND_URL=
PLATFORM_SEND_KEY=

# 线上配置为两个实际域名，且各 PUBLIC URL 改为对应 HTTPS URL。
BUSINESS_HOST=
FASTGPT_HOST=
